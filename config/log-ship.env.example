# /etc/pbx3sbc/log-ship.env — SBC log retention → org S3 (Phase 3)
# Spec: FLEET_LOG_RETENTION_REQUIREMENTS.md

# Org fleet bucket (same as instances). Omit / leave empty to disable upload (local rotate only).
PBX3_ORG_BUCKET=08jzwn-pbx3
AWS_DEFAULT_REGION=us-east-1

# S3 key stem: s3://$PBX3_ORG_BUCKET/sbc/$PBX3_SBC_ID/logs/{class}/…
PBX3_SBC_ID=sbc

# Upload enabled (true/false)
PBX3_LOG_UPLOAD_ENABLED=true

# dumpcap ring (also used by pbx3sbc-sip-pcap.service)
SIP_PCAP_DIR=/var/log/pbx3sbc/sip-pcap
SIP_PCAP_FILESIZE_KB=20000
SIP_PCAP_NUM_FILES=10

# State of already-shipped files
PBX3_LOG_SHIP_STATE=/var/lib/pbx3sbc/log-ship-state.json
